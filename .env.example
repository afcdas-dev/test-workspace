# Obrigatória — usada para estratégia de busca e análise dos criativos
# Obtenha em https://platform.claude.com/
ANTHROPIC_API_KEY=

# Opcional — modelo da Claude API (padrão: claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Opcional — token do Graph API da Meta para buscar anúncios REAIS na Ad Library.
# Sem ele, o sistema gera criativos simulados realistas para o nicho.
# Como obter: https://www.facebook.com/ads/library/api/
META_AD_LIBRARY_TOKEN=

# Porta do servidor (padrão: 3000)
# PORT=3000

# Copie este arquivo para .env e preencha. O .env é ignorado pelo git —
# nunca commite as suas chaves.

# Chave da API do Fal AI (https://fal.ai/dashboard/keys), formato "id:segredo".
FAL_KEY=

# Modelo de geração de imagens do Fal AI (opcional).
# FAL_MODEL=fal-ai/flux/schnell

# Demais variáveis do app (opcionais):
# PORT=3000
# BASE_URL=https://album.exemplo.com
# DATA_DIR=./data
# UPLOADS_DIR=./uploads
# META_PIXEL_ID=
